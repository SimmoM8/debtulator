# Copy to .env in the repository root and fill in values from the Supabase
# dashboard. .env is gitignored. Quote any value that contains spaces or shell
# characters. Do not commit filled-in copies.

# Direct Postgres connection, port 5432, not the transaction pooler (6543).
export DATABASE_URL='jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require'
export DATABASE_USERNAME='postgres'
export DATABASE_PASSWORD=''

export SUPABASE_URL='https://YOUR_PROJECT_REF.supabase.co'
# Publishable key or legacy anon key. Sent only to Supabase Auth.
export SUPABASE_AUTH_API_KEY=''
export SUPABASE_JWT_ISSUER='https://YOUR_PROJECT_REF.supabase.co/auth/v1'
export SUPABASE_JWKS_URI='https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json'
export SUPABASE_JWT_AUDIENCE='authenticated'

export AUTH_SIGNUP_REDIRECT_URL='debtulator://auth/confirm'
export AUTH_RECOVERY_REDIRECT_URL='debtulator://auth/reset-password'
export SUPABASE_AUTH_FORWARD_CLIENT_IP='false'

# Optional. The backend defaults to 8787.
# export PORT='8787'

# Expo reads mobile/.env, not this file. Copy this one line there.
# Use the computer's LAN address so a phone can reach the API.
# export EXPO_PUBLIC_API_URL='http://192.168.1.20:8787'
