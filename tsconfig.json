{
  "extends": "./apps/mobile/tsconfig.json",
  "compilerOptions": {
    "types": ["jest"],
    "paths": {
      "@/*": ["./apps/mobile/*"],
      "@debtulator/domain/*": ["./packages/domain/src/*"],
      "@debtulator/application/*": ["./packages/application/src/*"],
      "@debtulator/contracts/*": ["./packages/contracts/src/*"]
    }
  },
  "include": [
    "apps/mobile/**/*.ts",
    "apps/mobile/**/*.tsx",
    "apps/mobile/.expo/types/**/*.ts",
    "apps/mobile/expo-env.d.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["backend/supabase/functions"]
}
