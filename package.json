{
  "name": "debtulator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "start": "npm run start --workspace @debtulator/mobile",
    "postinstall": "patch-package",
    "reset-project": "node ./scripts/reset-project.js",
    "reset:test-data": "node ./scripts/reset-test-data.js",
    "preflight:beta": "node ./scripts/release-preflight.js --profile staging",
    "android": "npm run android --workspace @debtulator/mobile",
    "ios": "npm run ios --workspace @debtulator/mobile",
    "web": "npm run web --workspace @debtulator/mobile",
    "export:web": "npm run export:web --workspace @debtulator/mobile",
    "lint": "eslint apps/mobile/app apps/mobile/src apps/mobile/plugins packages scripts --max-warnings=0",
    "architecture": "node ./scripts/check-architecture.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./apps/mobile/jest.config.js --no-watchman",
    "quality": "npm run architecture && npm run typecheck && npm run lint && npm test -- --runInBand",
    "release:preflight": "node ./scripts/release-preflight.js",
    "release:preflight:config": "node ./scripts/release-preflight.js --config-only",
    "supabase:start": "npm run supabase:start --workspace @debtulator/backend",
    "supabase:stop": "npm run supabase:stop --workspace @debtulator/backend",
    "supabase:status": "npm run supabase:status --workspace @debtulator/backend",
    "supabase:reset": "npm run supabase:reset --workspace @debtulator/backend"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "patch-package": "^8.0.1",
    "supabase": "^2.107.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "overrides": {
    "react-native-screens": "4.25.2"
  }
}
