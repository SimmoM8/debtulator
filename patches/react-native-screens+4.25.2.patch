+static const NSInteger RNS_IOS26_LARGE_TITLE_BACKING_TAG = 0x524E5342;
+
+#if !TARGET_OS_TV
+/**
+ * iOS 26 suppresses the native large-title label when an explicit background
+ * is assigned to UINavigationBarAppearance. This view supplies the same color
+ * below the otherwise-transparent bar and follows UIKit's own bar-height
+ * transition, so it is gone when the compact bar is active.
+ */
+@interface RNSLargeTitleBackingView : UIView
+
+- (instancetype)initWithContainer:(UIView *)container
+                    navigationBar:(UINavigationBar *)navigationBar;
+- (void)setContainer:(UIView *)container;
+- (void)setBackingColor:(UIColor *)color;
+
+@end
+
+@implementation RNSLargeTitleBackingView {
+  __weak UINavigationBar *_navigationBar;
+  __weak UIView *_container;
+  UIColor *_originalBackgroundColor;
+  UIColor *_backingColor;
+  UIView *_originalCollectionBackgroundView;
+  BOOL _showsBacking;
+}
+
+- (instancetype)initWithContainer:(UIView *)container
+                    navigationBar:(UINavigationBar *)navigationBar
+{
+  if (self = [super initWithFrame:CGRectZero]) {
+    _navigationBar = navigationBar;
+    self.tag = RNS_IOS26_LARGE_TITLE_BACKING_TAG;
+    self.userInteractionEnabled = NO;
+    self.accessibilityElementsHidden = YES;
+    self.opaque = YES;
+    self.hidden = YES;
+    [navigationBar addObserver:self forKeyPath:@"bounds" options:NSKeyValueObservingOptionInitial context:nil];
+    [navigationBar addObserver:self forKeyPath:@"frame" options:0 context:nil];
+    [self setContainer:container];
+  }
+  return self;
+}
+
+- (void)setContainer:(UIView *)container
+{
+  if (_container == container) {
+    return;
+  }
+  UIView *previousContainer = _container;
+  previousContainer.backgroundColor = _originalBackgroundColor;
+  if ([previousContainer isKindOfClass:UICollectionView.class]) {
+    UICollectionView *previousCollectionView = (UICollectionView *)previousContainer;
+    if (previousCollectionView.backgroundView == self) {
+      previousCollectionView.backgroundView = _originalCollectionBackgroundView;
+    }
+  }
+  [self removeFromSuperview];
+  _container = container;
+  _originalBackgroundColor = container.backgroundColor;
+  _originalCollectionBackgroundView = nil;
+  if ([container isKindOfClass:UICollectionView.class]) {
+    UICollectionView *collectionView = (UICollectionView *)container;
+    _originalCollectionBackgroundView = collectionView.backgroundView;
+    collectionView.backgroundColor = UIColor.clearColor;
+    collectionView.backgroundView = self;
+  } else {
+    [container insertSubview:self atIndex:0];
+  }
+  self.hidden = NO;
+  [self updateForNavigationBar];
+}
+
+- (void)setBackingColor:(UIColor *)color
+{
+  _backingColor = color;
+  [self updateForNavigationBar];
+}
+
+- (void)dealloc
+{
+  UINavigationBar *navigationBar = _navigationBar;
+  if (navigationBar != nil) {
+    [navigationBar removeObserver:self forKeyPath:@"bounds"];
+    [navigationBar removeObserver:self forKeyPath:@"frame"];
+  }
+}
+
+- (void)observeValueForKeyPath:(NSString *)keyPath
+                      ofObject:(id)object
+                        change:(NSDictionary<NSKeyValueChangeKey, id> *)change
+                       context:(void *)context
+{
+  [self updateForNavigationBar];
+}
+
+- (void)updateForNavigationBar
+{
+  UINavigationBar *navigationBar = _navigationBar;
+  UIView *container = _container;
+  if (navigationBar == nil || container == nil || _backingColor == nil) {
+    _showsBacking = NO;
+    [self setNeedsDisplay];
+    return;
+  }
+
+  static const CGFloat compactNavigationBarHeight = 54.;
+  _showsBacking = navigationBar.bounds.size.height > compactNavigationBarHeight + .5;
+  self.frame = container.bounds;
+  [self setNeedsDisplay];
+  [container.window.rootViewController setNeedsStatusBarAppearanceUpdate];
+}
+
+- (void)drawRect:(CGRect)rect
+{
+  UIColor *baseColor = _originalBackgroundColor;
+  if (baseColor == nil || CGColorGetAlpha(baseColor.CGColor) == 0.) {
+    baseColor = UIColor.systemGroupedBackgroundColor;
+  }
+  [baseColor setFill];
+  UIRectFill(rect);
+  if (_backingColor == nil || !_showsBacking) {
+    return;
+  }
+  [_backingColor setFill];
+  UIRectFill(CGRectMake(0., 0., CGRectGetWidth(self.bounds), CGRectGetMaxY(_navigationBar.frame)));
+}
+
+@end
+
+static UIView *RNSFindScrollView(UIView *view)
+{
+  if ([view isKindOfClass:UIScrollView.class]) {
+    return view;
+  }
+  for (UIView *subview in view.subviews) {
+    UIView *scrollView = RNSFindScrollView(subview);
+    if (scrollView != nil) {
+      return scrollView;
+    }
+  }
+  return nil;
+}
+
+static void RNSConfigureIOS26LargeTitleBacking(
+    UIView *container, UINavigationBar *navigationBar, UIColor *color)
+{
+  if (container == nil) {
+    return;
+  }
+
+  RNSLargeTitleBackingView *backingView =
+      static_cast<RNSLargeTitleBackingView *>([container viewWithTag:RNS_IOS26_LARGE_TITLE_BACKING_TAG]);
+
+  if (color == nil) {
+    [backingView setBackingColor:nil];
+    return;
+  }
+
+  if (backingView == nil) {
+    UIView *backgroundContainer = RNSFindScrollView(container) ?: container;
+    backingView = [[RNSLargeTitleBackingView alloc] initWithContainer:backgroundContainer
+                                                       navigationBar:navigationBar];
+  }
+
+  [backingView setBackingColor:color];
+  __weak RNSLargeTitleBackingView *weakBackingView = backingView;
+  __weak UIView *weakContainer = container;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    UIView *mountedContainer = weakContainer;
+    RNSLargeTitleBackingView *mountedBackingView = weakBackingView;
+    if (mountedContainer == nil || mountedBackingView == nil) {
+      return;
+    }
+    UIView *scrollView = RNSFindScrollView(mountedContainer);
+    if (scrollView != nil) {
+      [mountedBackingView setContainer:scrollView];
+    }
+  });
+}
