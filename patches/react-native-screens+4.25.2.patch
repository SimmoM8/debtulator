+static BOOL RNSHasExpandedVisibleNavigationBar(UIView *view)
+{
+  if (view.hidden || view.alpha == 0.) {
+    return NO;
+  }
+  if ([view isKindOfClass:UINavigationBar.class]) {
+    UINavigationBar *navigationBar = (UINavigationBar *)view;
+    return navigationBar.prefersLargeTitles && navigationBar.bounds.size.height > 54.5;
+  }
+  for (UIView *subview in view.subviews) {
+    if (RNSHasExpandedVisibleNavigationBar(subview)) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
